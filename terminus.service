[Unit]
Description=Terminus - The endpoint you can reach anywhere
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jewboy420/terminus
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 9120
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
